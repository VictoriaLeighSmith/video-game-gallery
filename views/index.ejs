<%- include('partials/header', { title: "Home" }) %>

<main class="main-content">
  <div class="index-logo-container">
    <img src="/images/recoloured-icon.png" class="index-logo" />
  </div>

  <ul class="game-list">
    <% randomGames.forEach((randomGame) => { %>
    <li>
      <div class="game-card-glow">
        <a class="game-card pixel-corners" href="/game/<%= randomGame.id %>">
          <div class="title-rating-container">
            <h2><%= randomGame.title %></h2>

            <p class="game-rating">
              <img
                class="star-rating-icon"
                src="/images/yellow-star.png"
                alt="Video game controller logo"
              />
              <%= randomGame.averageRating === null
                                ? "N/A"
                                : randomGame.averageRating %>
            </p>
          </div>

          <div class="game-info-container">
            <p class="release-year"><%= randomGame.releaseYear %></p>
            <p>&bull;</p>
            <p class="genre"><%= randomGame.genre %></p>
          </div>
        </a>
      </div>
    </li>
    <% }) %>
  </ul>
</main>
<%- include('partials/footer') %>
