<%- include('partials/header', {title: "Game Details: "}) %>


    <main class="main-content quote-details-content">
        <h1>Game Details</h1>

        <p class="game-text">Title: <%= game.title %></p>
        <p class="game-text">Description: <%= game.description %></p>
        <p class="game-text">Release Year: <%= game.releaseYear %></p>
        <p class="game-text">Developer: <%= game.developer %></p>
        <p class="game-text">
            Rating:
            <%= game.averageRating === null ? "This game has not yet been rated." : game.averageRating %>
        </p>
        <p class="game-text">Genre: <%= game.genre %></p>

        <a href="/" class="back-link">Back to Home</a>

        <h2>You May Also Like</h2>

      <ul>
    <% recommendedGames.forEach((recommendedGame) => { %>
        <li>
            <a href="/game/<%= recommendedGame.id %>">
                <%= recommendedGame.title %>
            </a>

            <p>Release Year: <%= recommendedGame.releaseYear %></p>
            <p>
                Rating:
                <%= recommendedGame.averageRating === null
                    ? "This game has not yet been rated."
                    : recommendedGame.averageRating %>
            </p>
        </li>
    <% }) %>
</ul>

    </main>
    <%- include('partials/footer') %>

