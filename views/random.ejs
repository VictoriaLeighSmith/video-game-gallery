<%- include('partials/header', { title: "Top Rated Video Games" }) %>

    <main class="main-content">
        <h1>Top Rated Games</h1>

        <ul class="game-list">
            <% games.forEach((game) => { %>
                <li class="game-card">
                    <a href="/game/<%= game.id %>"><%= game.title %></a>

                    <p>Release Year: <%= game.releaseYear %></p>
                    <p>
                        Rating:
                        <%= game.averageRating === null
                            ? "N/A"
                            : game.averageRating %>
                    </p>
                    <p>Description: <%= game.description %></p>
                </li>
            <% }) %>
        </ul>

    </main>
<%- include('partials/footer') %>