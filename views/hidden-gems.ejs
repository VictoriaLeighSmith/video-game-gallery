<%- include('partials/header', { title: "Hidden Gems" }) %>

    <main class="main-content">
        <h1>Hidden Gems</h1>

        <ul>
            <% games.forEach((game) => { %>
                <li>
                    <a href="/game/<%= game.id %>"><%= game.title %></a>

                    <p>Release Year: <%= game.releaseYear %></p>
                    <p>
                        Rating:
                        <%= game.averageRating === null
                            ? "This game has not yet been rated."
                            : game.averageRating %>
                    </p>
                    <p>Description: <%= game.description %></p>
                </li>
            <% }) %>
        </ul>
    </main>
<%- include('partials/footer') %>